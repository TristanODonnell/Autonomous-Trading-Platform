{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__elements": {},
  "__requires": [
    {"type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0"},
    {"type": "panel", "id": "barchart", "name": "Bar chart", "version": ""},
    {"type": "panel", "id": "stat", "name": "Stat", "version": ""},
    {"type": "panel", "id": "timeseries", "name": "Time series", "version": ""},
    {"type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0"}
  ],
  "annotations": {"list": []},
  "description": "Research pipeline orchestration observability — stage throughput, cache efficiency, checkpoint states, parallel execution",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "id": 100,
      "title": "Pipeline Funnel",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Candidates entering vs passing each pipeline stage",
      "fieldConfig": {
        "defaults": {"unit": "short"},
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 1},
      "id": 1,
      "options": {
        "barWidth": 0.7,
        "groupWidth": 0.7,
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "orientation": "auto",
        "xTickLabelRotation": -30,
        "xTickLabelSpacing": 0
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "sum by (stage_name) (ratp_research_stage_survivors_entered_bucket{le=\"+Inf\"})",
          "legendFormat": "entered: {{stage_name}}",
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "sum by (stage_name) (ratp_research_stage_survivors_passed_bucket{le=\"+Inf\"})",
          "legendFormat": "passed: {{stage_name}}",
          "refId": "B"
        }
      ],
      "title": "Stage Survivor Funnel",
      "type": "barchart"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Stage pass rate (passed / entered) per stage",
      "fieldConfig": {
        "defaults": {"unit": "percentunit", "min": 0, "max": 1},
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 1},
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "sum by (stage_name) (rate(ratp_research_stage_runs_total{status=\"completed\"}[10m])) / sum by (stage_name) (rate(ratp_research_stage_runs_total[10m]))",
          "legendFormat": "{{stage_name}}",
          "refId": "A"
        }
      ],
      "title": "Stage Pass Rate",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 9},
      "id": 101,
      "title": "Stage Duration",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "p50/p95 execution duration per pipeline stage",
      "fieldConfig": {
        "defaults": {"unit": "s"},
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 10},
      "id": 3,
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "none"}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "histogram_quantile(0.50, sum by (stage_name, le) (rate(ratp_research_stage_duration_seconds_bucket[10m])))",
          "legendFormat": "p50 {{stage_name}}",
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "histogram_quantile(0.95, sum by (stage_name, le) (rate(ratp_research_stage_duration_seconds_bucket[10m])))",
          "legendFormat": "p95 {{stage_name}}",
          "refId": "B"
        }
      ],
      "title": "Stage Duration (p50 / p95)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 18},
      "id": 102,
      "title": "Cache Efficiency",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Cache hit rate for simulation and generation caches",
      "fieldConfig": {
        "defaults": {"unit": "percentunit", "min": 0, "max": 1,
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "red", "value": null},
            {"color": "yellow", "value": 0.3},
            {"color": "green", "value": 0.7}
          ]}
        },
        "overrides": []
      },
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 19},
      "id": 4,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "sum(rate(ratp_research_cache_lookups_total{cache_type=\"simulation\",result=\"hit\"}[10m])) / sum(rate(ratp_research_cache_lookups_total{cache_type=\"simulation\"}[10m]))",
          "legendFormat": "simulation hit rate",
          "refId": "A"
        }
      ],
      "title": "Simulation Cache Hit Rate",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Strategy generation cache hit rate",
      "fieldConfig": {
        "defaults": {"unit": "percentunit", "min": 0, "max": 1,
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "red", "value": null},
            {"color": "yellow", "value": 0.3},
            {"color": "green", "value": 0.7}
          ]}
        },
        "overrides": []
      },
      "gridPos": {"h": 6, "w": 8, "x": 8, "y": 19},
      "id": 5,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "sum(rate(ratp_research_cache_lookups_total{cache_type=\"generation\",result=\"hit\"}[10m])) / sum(rate(ratp_research_cache_lookups_total{cache_type=\"generation\"}[10m]))",
          "legendFormat": "generation hit rate",
          "refId": "A"
        }
      ],
      "title": "Generation Cache Hit Rate",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Cache lookup volume over time (hits vs misses)",
      "fieldConfig": {
        "defaults": {"unit": "reqps"},
        "overrides": []
      },
      "gridPos": {"h": 6, "w": 8, "x": 16, "y": 19},
      "id": 6,
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "none"}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "sum by (cache_type, result) (rate(ratp_research_cache_lookups_total[5m]))",
          "legendFormat": "{{cache_type}} {{result}}",
          "refId": "A"
        }
      ],
      "title": "Cache Lookup Rate",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 25},
      "id": 103,
      "title": "Checkpoint State Distribution",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Checkpoint state transition rate by terminal status",
      "fieldConfig": {
        "defaults": {"unit": "short"},
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 26},
      "id": 7,
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "none"}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "sum by (task_type, to_status) (rate(ratp_research_checkpoint_transitions_total[5m]))",
          "legendFormat": "{{task_type}} → {{to_status}}",
          "refId": "A"
        }
      ],
      "title": "Checkpoint Transitions / sec",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "p50/p95 checkpoint completion time by task type",
      "fieldConfig": {
        "defaults": {"unit": "s"},
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 26},
      "id": 8,
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "none"}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "histogram_quantile(0.50, sum by (task_type, le) (rate(ratp_research_checkpoint_duration_seconds_bucket[10m])))",
          "legendFormat": "p50 {{task_type}}",
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "histogram_quantile(0.95, sum by (task_type, le) (rate(ratp_research_checkpoint_duration_seconds_bucket[10m])))",
          "legendFormat": "p95 {{task_type}}",
          "refId": "B"
        }
      ],
      "title": "Checkpoint Duration (p50 / p95)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 34},
      "id": 104,
      "title": "Parallel Execution",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Parallel execution unit success and failure rates",
      "fieldConfig": {
        "defaults": {"unit": "reqps"},
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 35},
      "id": 9,
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "none"}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "sum by (stage_name, mode, status) (rate(ratp_research_parallel_unit_runs_total[5m]))",
          "legendFormat": "{{stage_name}} {{mode}} {{status}}",
          "refId": "A"
        }
      ],
      "title": "Parallel Unit Throughput",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "p50/p95 per-unit execution duration",
      "fieldConfig": {
        "defaults": {"unit": "s"},
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 35},
      "id": 10,
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "none"}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "histogram_quantile(0.50, sum by (stage_name, le) (rate(ratp_research_parallel_unit_duration_seconds_bucket[10m])))",
          "legendFormat": "p50 {{stage_name}}",
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "histogram_quantile(0.95, sum by (stage_name, le) (rate(ratp_research_parallel_unit_duration_seconds_bucket[10m])))",
          "legendFormat": "p95 {{stage_name}}",
          "refId": "B"
        }
      ],
      "title": "Parallel Unit Duration (p50 / p95)",
      "type": "timeseries"
    }
  ],
  "schemaVersion": 39,
  "tags": ["ratp", "research"],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "name": "DS_PROMETHEUS",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "type": "datasource"
      }
    ]
  },
  "time": {"from": "now-6h", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "Research Pipeline",
  "uid": "ratp-research-pipeline",
  "version": 1,
  "weekStart": ""
}
