{
  "uid": "ratp-governance-runtime",
  "title": "RATP Governance Runtime",
  "tags": [
    "ratp",
    "governance"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(environment)",
        "includeAll": true,
        "allValue": ".*",
        "refresh": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "correlation_id",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      },
      {
        "name": "strategy_id",
        "type": "query",
        "datasource": {
          "type": "postgres",
          "uid": "ratp-postgres"
        },
        "query": "SELECT DISTINCT strategy_id FROM strategy_governance ORDER BY 1",
        "includeAll": true,
        "allValue": "%",
        "refresh": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "job_name",
        "type": "query",
        "datasource": {
          "type": "postgres",
          "uid": "ratp-postgres"
        },
        "query": "SELECT DISTINCT job_name FROM runtime_job_runs ORDER BY 1",
        "includeAll": true,
        "allValue": "%",
        "refresh": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Annotations & Alerts",
        "type": "dashboard",
        "builtIn": 1,
        "hide": true,
        "enable": true
      }
    ]
  },
  "links": [
    {
      "title": "Tempo by correlation_id",
      "type": "link",
      "url": "/explore?left={\"datasource\":\"tempo\",\"queries\":[{\"query\":\"{ratp.correlation_id=\\\"${correlation_id}\\\"}\"}]}"
    },
    {
      "title": "Loki by correlation_id",
      "type": "link",
      "url": "/explore?left={\"datasource\":\"loki\",\"queries\":[{\"expr\":\"{} | json | correlation_id=\\\"${correlation_id}\\\"\"}]}"
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "Governance job status",
      "type": "table",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "ratp-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "ratp-postgres"
          },
          "rawSql": "SELECT job_name, status, count(*) AS runs, max(started_at) AS latest_started_at, max(correlation_id) AS latest_correlation_id FROM runtime_job_runs WHERE $__timeFilter(started_at) AND job_name IN ('strategy_auto_promotion_cycle','strategy_auto_demotion_cycle','strategy_allocation_rebalance_cycle') AND job_name LIKE '$job_name' GROUP BY job_name, status ORDER BY job_name, status",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "Tempo by correlation_id",
              "url": "/explore?left={\"datasource\":\"tempo\",\"queries\":[{\"query\":\"{ratp.correlation_id=\\\"${correlation_id}\\\"}\"}]}"
            },
            {
              "title": "Loki by correlation_id",
              "url": "/explore?left={\"datasource\":\"loki\",\"queries\":[{\"expr\":\"{} | json | correlation_id=\\\"${correlation_id}\\\"\"}]}"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 2,
      "title": "Governance cycle duration",
      "type": "timeseries",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, component) (rate(ratp_governance_cycle_duration_seconds_bucket{environment=~\"$environment\"}[5m])))",
          "legendFormat": "{{component}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "Tempo by correlation_id",
              "url": "/explore?left={\"datasource\":\"tempo\",\"queries\":[{\"query\":\"{ratp.correlation_id=\\\"${correlation_id}\\\"}\"}]}"
            },
            {
              "title": "Loki by correlation_id",
              "url": "/explore?left={\"datasource\":\"loki\",\"queries\":[{\"expr\":\"{} | json | correlation_id=\\\"${correlation_id}\\\"\"}]}"
            }
          ],
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "Strategy governance states",
      "type": "table",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "ratp-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "ratp-postgres"
          },
          "rawSql": "SELECT current_state, count(*) AS strategies FROM strategy_governance WHERE strategy_id LIKE '$strategy_id' GROUP BY current_state ORDER BY strategies DESC",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "Tempo by correlation_id",
              "url": "/explore?left={\"datasource\":\"tempo\",\"queries\":[{\"query\":\"{ratp.correlation_id=\\\"${correlation_id}\\\"}\"}]}"
            },
            {
              "title": "Loki by correlation_id",
              "url": "/explore?left={\"datasource\":\"loki\",\"queries\":[{\"expr\":\"{} | json | correlation_id=\\\"${correlation_id}\\\"\"}]}"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 4,
      "title": "Promotion/demotion decisions",
      "type": "table",
      "description": "",
      "gridPos": {
        "x": 8,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "ratp-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "ratp-postgres"
          },
          "rawSql": "SELECT event_timestamp, event_type, run_id, component, message, metadata FROM audit_logs WHERE $__timeFilter(event_timestamp) AND event_type IN ('STRATEGY_AUTO_PROMOTION_COMPLETED','STRATEGY_AUTO_DEMOTION_COMPLETED','STRATEGY_AUTO_PROMOTED','STRATEGY_AUTO_DEMOTED','STRATEGY_GOVERNANCE_TRANSITIONED') ORDER BY event_timestamp DESC LIMIT 100",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "Tempo by correlation_id",
              "url": "/explore?left={\"datasource\":\"tempo\",\"queries\":[{\"query\":\"{ratp.correlation_id=\\\"${correlation_id}\\\"}\"}]}"
            },
            {
              "title": "Loki by correlation_id",
              "url": "/explore?left={\"datasource\":\"loki\",\"queries\":[{\"expr\":\"{} | json | correlation_id=\\\"${correlation_id}\\\"\"}]}"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 5,
      "title": "Risk block and control state",
      "type": "table",
      "description": "",
      "gridPos": {
        "x": 16,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "ratp-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "ratp-postgres"
          },
          "rawSql": "SELECT 'runtime_control' AS source, trading_mode, trading_enabled, trading_paused, kill_switch_enabled, reason, updated_at FROM runtime_control_state UNION ALL SELECT 'latest_risk' AS source, NULL, NOT is_blocked, NULL, NULL, array_to_string(block_reasons, ', '), timestamp FROM risk_snapshots ORDER BY updated_at DESC LIMIT 20",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "Tempo by correlation_id",
              "url": "/explore?left={\"datasource\":\"tempo\",\"queries\":[{\"query\":\"{ratp.correlation_id=\\\"${correlation_id}\\\"}\"}]}"
            },
            {
              "title": "Loki by correlation_id",
              "url": "/explore?left={\"datasource\":\"loki\",\"queries\":[{\"expr\":\"{} | json | correlation_id=\\\"${correlation_id}\\\"\"}]}"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 6,
      "title": "Governance logs",
      "type": "logs",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=~\".+\"} | json | component=~\".*governance.*|.*strategy.*\" |~ \"$correlation_id\"",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "Tempo by correlation_id",
              "url": "/explore?left={\"datasource\":\"tempo\",\"queries\":[{\"query\":\"{ratp.correlation_id=\\\"${correlation_id}\\\"}\"}]}"
            },
            {
              "title": "Loki by correlation_id",
              "url": "/explore?left={\"datasource\":\"loki\",\"queries\":[{\"expr\":\"{} | json | correlation_id=\\\"${correlation_id}\\\"\"}]}"
            }
          ]
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "title": "Automated decisions (7d)",
      "description": "Every decision an automation took or recorded in the last 7 days: governance (auto promotion/demotion), portfolio review decisions, allocation rebalances. worker_run_id links a review to the worker run it consumed (plan 3.1).",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 14,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "ratp-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "ratp-postgres"
          },
          "rawSql": "SELECT ts, automation, strategy_id, outcome, reason, worker_run_id FROM (\n  SELECT recorded_at AS ts, 'governance:' || event_type AS automation, strategy_id,\n         decision_outcome AS outcome, left(coalesce(decision_rationale, ''), 120) AS reason,\n         NULL::text AS worker_run_id\n  FROM governance_audit_events\n  WHERE trigger_source IN ('scheduler', 'auto_promotion', 'auto_demotion', 'automated')\n  UNION ALL\n  SELECT d.reviewed_at, 'review:' || d.decision_type, d.strategy_id,\n         CASE WHEN d.applied THEN 'applied' ELSE 'advisory' END, d.reason, r.worker_run_id\n  FROM portfolio_review_decisions d\n  LEFT JOIN portfolio_reviews r ON r.review_id = d.review_id\n  UNION ALL\n  SELECT started_at, 'rebalance', coalesce(trigger_source, 'scheduler'), status,\n         coalesce(skipped_reason, 'changes=' || coalesce(allocation_changes_count, 0)::text), run_id\n  FROM allocation_rebalance_history\n  WHERE actor <> 'operator'\n) x\nWHERE ts > now() - interval '7 days'\nORDER BY ts DESC\nLIMIT 200",
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "ts",
            "desc": true
          }
        ]
      }
    },
    {
      "id": 8,
      "title": "Worker results (7d): accepted / rejected",
      "description": "Results the research worker handed over and what Box A decided. Rejections name the reason: switch off, kill switch, stale dataset, git SHA mismatch (plan 3.1).",
      "type": "table",
      "gridPos": {
        "x": 14,
        "y": 16,
        "w": 10,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "ratp-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "ratp-postgres"
          },
          "rawSql": "SELECT received_at, run_id, result_type, status, coalesce(rejection_reason, '') AS reason,\n       dataset_as_of, left(coalesce(git_sha, ''), 9) AS git_sha, worker_host\nFROM worker_result_submissions\nWHERE received_at > now() - interval '7 days'\nORDER BY received_at DESC\nLIMIT 100",
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "rejected": {
                        "color": "red",
                        "index": 0
                      }
                    }
                  },
                  {
                    "type": "value",
                    "options": {
                      "accepted": {
                        "color": "green",
                        "index": 1
                      }
                    }
                  },
                  {
                    "type": "value",
                    "options": {
                      "applied": {
                        "color": "blue",
                        "index": 2
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 9,
      "title": "Automation switches",
      "description": "Effective switches right now. The kill switch overrides every automation (`atp controls automation` prints the same).",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 4
      },
      "datasource": {
        "type": "postgres",
        "uid": "ratp-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "ratp-postgres"
          },
          "rawSql": "SELECT\n  (SELECT is_enabled FROM kill_switch_state WHERE id = 'current') AS kill_switch,\n  auto_promote_enabled, auto_demote_on_breach, auto_rebalance_enabled,\n  portfolio_review_mode, worker_results_enabled, worker_result_max_age_days,\n  worker_result_require_matching_git_sha, updated_at\nFROM operator_settings\nORDER BY updated_at DESC\nLIMIT 1",
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true
      }
    }
  ]
}
