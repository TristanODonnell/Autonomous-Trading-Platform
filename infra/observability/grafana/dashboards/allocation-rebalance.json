{
  "uid": "ratp-allocation-rebalance",
  "title": "RATP Allocation Rebalance",
  "tags": [
    "ratp",
    "allocation"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(environment)",
        "includeAll": true,
        "allValue": ".*",
        "refresh": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "correlation_id",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      },
      {
        "name": "strategy_id",
        "type": "query",
        "datasource": {
          "type": "postgres",
          "uid": "ratp-postgres"
        },
        "query": "SELECT DISTINCT strategy_id FROM strategy_governance ORDER BY 1",
        "includeAll": true,
        "allValue": "%",
        "refresh": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "job_name",
        "type": "query",
        "datasource": {
          "type": "postgres",
          "uid": "ratp-postgres"
        },
        "query": "SELECT DISTINCT job_name FROM runtime_job_runs ORDER BY 1",
        "includeAll": true,
        "allValue": "%",
        "refresh": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Annotations & Alerts",
        "type": "dashboard",
        "builtIn": 1,
        "hide": true,
        "enable": true
      }
    ]
  },
  "links": [
    {
      "title": "Tempo by correlation_id",
      "type": "link",
      "url": "/explore?left={\"datasource\":\"tempo\",\"queries\":[{\"query\":\"{ratp.correlation_id=\\\"${correlation_id}\\\"}\"}]}"
    },
    {
      "title": "Loki by correlation_id",
      "type": "link",
      "url": "/explore?left={\"datasource\":\"loki\",\"queries\":[{\"expr\":\"{} | json | correlation_id=\\\"${correlation_id}\\\"\"}]}"
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "Allocation rebalance job status",
      "type": "table",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "ratp-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "ratp-postgres"
          },
          "rawSql": "SELECT job_name, status, started_at, completed_at, duration_ms, correlation_id, error_message FROM runtime_job_runs WHERE job_name = 'strategy_allocation_rebalance_cycle' ORDER BY started_at DESC LIMIT 50",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "Tempo by correlation_id",
              "url": "/explore?left={\"datasource\":\"tempo\",\"queries\":[{\"query\":\"{ratp.correlation_id=\\\"${correlation_id}\\\"}\"}]}"
            },
            {
              "title": "Loki by correlation_id",
              "url": "/explore?left={\"datasource\":\"loki\",\"queries\":[{\"expr\":\"{} | json | correlation_id=\\\"${correlation_id}\\\"\"}]}"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 2,
      "title": "Allocation cycle duration p95",
      "type": "timeseries",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, component) (rate(ratp_allocation_cycle_duration_seconds_bucket{environment=~\"$environment\"}[5m])))",
          "legendFormat": "{{component}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "Tempo by correlation_id",
              "url": "/explore?left={\"datasource\":\"tempo\",\"queries\":[{\"query\":\"{ratp.correlation_id=\\\"${correlation_id}\\\"}\"}]}"
            },
            {
              "title": "Loki by correlation_id",
              "url": "/explore?left={\"datasource\":\"loki\",\"queries\":[{\"expr\":\"{} | json | correlation_id=\\\"${correlation_id}\\\"\"}]}"
            }
          ],
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "Rebalance actions and outcomes",
      "type": "table",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "ratp-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "ratp-postgres"
          },
          "rawSql": "SELECT event_timestamp, event_type, run_id, message, metadata FROM audit_logs WHERE $__timeFilter(event_timestamp) AND event_type IN ('STRATEGY_ALLOCATION_REBALANCED','STRATEGY_ALLOCATION_REBALANCE_NOOP','STRATEGY_ALLOCATION_REBALANCE_SKIPPED','STRATEGY_ALLOCATION_REBALANCE_FAILED','ALLOCATION_OVERRIDE_CREATED','ALLOCATION_OVERRIDE_EXPIRED') ORDER BY event_timestamp DESC LIMIT 100",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "Tempo by correlation_id",
              "url": "/explore?left={\"datasource\":\"tempo\",\"queries\":[{\"query\":\"{ratp.correlation_id=\\\"${correlation_id}\\\"}\"}]}"
            },
            {
              "title": "Loki by correlation_id",
              "url": "/explore?left={\"datasource\":\"loki\",\"queries\":[{\"expr\":\"{} | json | correlation_id=\\\"${correlation_id}\\\"\"}]}"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 4,
      "title": "Active allocation overrides",
      "type": "table",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "ratp-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "ratp-postgres"
          },
          "rawSql": "SELECT strategy_id, max_pct_of_capital, max_position_size_usd, max_drawdown_allowed, override_reason, overridden_by, created_at, expires_at FROM allocation_overrides WHERE is_active = true AND strategy_id LIKE '$strategy_id' ORDER BY created_at DESC",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "Tempo by correlation_id",
              "url": "/explore?left={\"datasource\":\"tempo\",\"queries\":[{\"query\":\"{ratp.correlation_id=\\\"${correlation_id}\\\"}\"}]}"
            },
            {
              "title": "Loki by correlation_id",
              "url": "/explore?left={\"datasource\":\"loki\",\"queries\":[{\"expr\":\"{} | json | correlation_id=\\\"${correlation_id}\\\"\"}]}"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 5,
      "title": "Risk and equity context",
      "type": "table",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "ratp-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "ratp-postgres"
          },
          "rawSql": "SELECT timestamp, gross_exposure, net_exposure, leverage, drawdown_pct, is_blocked, block_reasons FROM risk_snapshots ORDER BY timestamp DESC LIMIT 50",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "Tempo by correlation_id",
              "url": "/explore?left={\"datasource\":\"tempo\",\"queries\":[{\"query\":\"{ratp.correlation_id=\\\"${correlation_id}\\\"}\"}]}"
            },
            {
              "title": "Loki by correlation_id",
              "url": "/explore?left={\"datasource\":\"loki\",\"queries\":[{\"expr\":\"{} | json | correlation_id=\\\"${correlation_id}\\\"\"}]}"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 6,
      "title": "Allocation logs",
      "type": "logs",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=~\".+\"} | json | component=~\".*allocation.*|.*rebalance.*\" |~ \"$correlation_id\"",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "Tempo by correlation_id",
              "url": "/explore?left={\"datasource\":\"tempo\",\"queries\":[{\"query\":\"{ratp.correlation_id=\\\"${correlation_id}\\\"}\"}]}"
            },
            {
              "title": "Loki by correlation_id",
              "url": "/explore?left={\"datasource\":\"loki\",\"queries\":[{\"expr\":\"{} | json | correlation_id=\\\"${correlation_id}\\\"\"}]}"
            }
          ]
        },
        "overrides": []
      },
      "options": {}
    }
  ]
}
