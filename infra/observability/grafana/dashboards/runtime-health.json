{
  "uid": "ratp-runtime-health",
  "title": "RATP Runtime Health",
  "tags": [
    "ratp",
    "runtime"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(environment)",
        "includeAll": true,
        "allValue": ".*",
        "refresh": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "correlation_id",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      },
      {
        "name": "strategy_id",
        "type": "query",
        "datasource": {
          "type": "postgres",
          "uid": "ratp-postgres"
        },
        "query": "SELECT DISTINCT strategy_id FROM strategy_governance ORDER BY 1",
        "includeAll": true,
        "allValue": "%",
        "refresh": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "job_name",
        "type": "query",
        "datasource": {
          "type": "postgres",
          "uid": "ratp-postgres"
        },
        "query": "SELECT DISTINCT job_name FROM runtime_job_runs ORDER BY 1",
        "includeAll": true,
        "allValue": "%",
        "refresh": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Annotations & Alerts",
        "type": "dashboard",
        "builtIn": 1,
        "hide": true,
        "enable": true
      }
    ]
  },
  "links": [
    {
      "title": "Tempo by correlation_id",
      "type": "link",
      "url": "/explore?left={\"datasource\":\"tempo\",\"queries\":[{\"query\":\"{ratp.correlation_id=\\\"${correlation_id}\\\"}\"}]}"
    },
    {
      "title": "Loki by correlation_id",
      "type": "link",
      "url": "/explore?left={\"datasource\":\"loki\",\"queries\":[{\"expr\":\"{} | json | correlation_id=\\\"${correlation_id}\\\"\"}]}"
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "Job run status by job_name",
      "type": "table",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "ratp-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "ratp-postgres"
          },
          "rawSql": "SELECT job_name, status, count(*) AS runs, max(started_at) AS latest_started_at, max(completed_at) AS latest_completed_at FROM runtime_job_runs WHERE $__timeFilter(started_at) AND job_name LIKE '$job_name' GROUP BY job_name, status ORDER BY job_name, status",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "Tempo by correlation_id",
              "url": "/explore?left={\"datasource\":\"tempo\",\"queries\":[{\"query\":\"{ratp.correlation_id=\\\"${correlation_id}\\\"}\"}]}"
            },
            {
              "title": "Loki by correlation_id",
              "url": "/explore?left={\"datasource\":\"loki\",\"queries\":[{\"expr\":\"{} | json | correlation_id=\\\"${correlation_id}\\\"\"}]}"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 2,
      "title": "Latest successful run age",
      "type": "table",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "ratp-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "ratp-postgres"
          },
          "rawSql": "SELECT job_name, EXTRACT(EPOCH FROM (now() - max(completed_at))) AS age_seconds FROM runtime_job_runs WHERE status = 'completed' AND job_name LIKE '$job_name' GROUP BY job_name ORDER BY age_seconds DESC",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "Tempo by correlation_id",
              "url": "/explore?left={\"datasource\":\"tempo\",\"queries\":[{\"query\":\"{ratp.correlation_id=\\\"${correlation_id}\\\"}\"}]}"
            },
            {
              "title": "Loki by correlation_id",
              "url": "/explore?left={\"datasource\":\"loki\",\"queries\":[{\"expr\":\"{} | json | correlation_id=\\\"${correlation_id}\\\"\"}]}"
            }
          ],
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 3,
      "title": "Cycle duration p50/p95",
      "type": "timeseries",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.50, sum by (le, component) (rate(ratp_trading_cycle_duration_seconds_bucket{environment=~\"$environment\"}[5m])))",
          "legendFormat": "{{component}} {{status}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, component) (rate(ratp_trading_cycle_duration_seconds_bucket{environment=~\"$environment\"}[5m])))",
          "legendFormat": "{{component}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "Tempo by correlation_id",
              "url": "/explore?left={\"datasource\":\"tempo\",\"queries\":[{\"query\":\"{ratp.correlation_id=\\\"${correlation_id}\\\"}\"}]}"
            },
            {
              "title": "Loki by correlation_id",
              "url": "/explore?left={\"datasource\":\"loki\",\"queries\":[{\"expr\":\"{} | json | correlation_id=\\\"${correlation_id}\\\"\"}]}"
            }
          ],
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "Step duration p95",
      "type": "timeseries",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, step, component) (rate(ratp_trading_cycle_step_duration_seconds_bucket{environment=~\"$environment\"}[5m])))",
          "legendFormat": "{{component}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "Tempo by correlation_id",
              "url": "/explore?left={\"datasource\":\"tempo\",\"queries\":[{\"query\":\"{ratp.correlation_id=\\\"${correlation_id}\\\"}\"}]}"
            },
            {
              "title": "Loki by correlation_id",
              "url": "/explore?left={\"datasource\":\"loki\",\"queries\":[{\"expr\":\"{} | json | correlation_id=\\\"${correlation_id}\\\"\"}]}"
            }
          ],
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "title": "Failure and degraded rates",
      "type": "timeseries",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (component, failure_class) (rate(ratp_trading_cycle_failures_total{environment=~\"$environment\"}[5m]))",
          "legendFormat": "{{component}} {{status}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (component) (rate(ratp_trading_cycle_degraded_total{environment=~\"$environment\"}[5m]))",
          "legendFormat": "{{component}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "Tempo by correlation_id",
              "url": "/explore?left={\"datasource\":\"tempo\",\"queries\":[{\"query\":\"{ratp.correlation_id=\\\"${correlation_id}\\\"}\"}]}"
            },
            {
              "title": "Loki by correlation_id",
              "url": "/explore?left={\"datasource\":\"loki\",\"queries\":[{\"expr\":\"{} | json | correlation_id=\\\"${correlation_id}\\\"\"}]}"
            }
          ]
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "title": "Stale/hung/orphan/duplicate health checks",
      "type": "table",
      "description": "",
      "gridPos": {
        "x": 8,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "ratp-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "ratp-postgres"
          },
          "rawSql": "SELECT job_name, status, started_at, completed_at, error_message, correlation_id FROM runtime_job_runs WHERE (status = 'running' AND started_at < now() - interval '30 minutes') OR (parent_job_run_id IS NOT NULL AND NOT EXISTS (SELECT 1 FROM runtime_job_runs p WHERE p.job_run_id = runtime_job_runs.parent_job_run_id)) ORDER BY started_at DESC LIMIT 100",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "Tempo by correlation_id",
              "url": "/explore?left={\"datasource\":\"tempo\",\"queries\":[{\"query\":\"{ratp.correlation_id=\\\"${correlation_id}\\\"}\"}]}"
            },
            {
              "title": "Loki by correlation_id",
              "url": "/explore?left={\"datasource\":\"loki\",\"queries\":[{\"expr\":\"{} | json | correlation_id=\\\"${correlation_id}\\\"\"}]}"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 7,
      "title": "Ingestion freshness",
      "type": "timeseries",
      "description": "",
      "gridPos": {
        "x": 16,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "ratp_ingestion_lag_seconds",
          "legendFormat": "{{component}} {{status}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "ratp_symbols_expected",
          "legendFormat": "{{component}} {{status}}"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "ratp_symbols_received",
          "legendFormat": "{{component}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "Tempo by correlation_id",
              "url": "/explore?left={\"datasource\":\"tempo\",\"queries\":[{\"query\":\"{ratp.correlation_id=\\\"${correlation_id}\\\"}\"}]}"
            },
            {
              "title": "Loki by correlation_id",
              "url": "/explore?left={\"datasource\":\"loki\",\"queries\":[{\"expr\":\"{} | json | correlation_id=\\\"${correlation_id}\\\"\"}]}"
            }
          ]
        },
        "overrides": []
      },
      "options": {}
    }
  ]
}
