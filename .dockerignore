# Virtual environments
.venv/
.venv-*/
env/
venv/
ENV/

# Git
.git/
.gitignore

# Python cache/build artifacts
__pycache__/
**/__pycache__/
*.pyc
*.py[codz]
*.egg-info/
build/
dist/

# Test/lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Logs and runtime artifacts (this is what broke your build)
orchestration/logs/
data/
artifacts/
.task_progress.json
.runtime/
.tmp/

# Secrets — never send these into a build context
.env*
!.env.example
infra/.env

# Frontend dependencies (the image only runs the backend)
**/node_modules/

# Editor/IDE
.idea/
.vscode/

# Misc
*.db
*.sqlite
*.sqlite3
*.sql
*.dump
private-notes/
.claude/

# Not needed at runtime. data/ and artifacts/ are bind-mounted by compose; on the box they
# hold every Parquet file ingested so far, and copying them into the image once filled the
# disk (2026-10-12). tests/, docs/ and screenshots just bloat the layers.
data/
artifacts/
tests/
visualization/
frontend/
docs/*
!docs/operations
.github/
.idea/
.mypy_cache/
.pytest_cache/
.ruff_cache/
orchestration/
*.dump
dump.sql
