# Box B (research worker). Copy to .env.worker on the box; docker-compose.worker.yml reads it.
# Backtest-only: no broker trading keys, no JWT, no live modules. See
# docs/operations/runbooks/worker-box.md.

APP_ENV=backtest
TRADING_ENVIRONMENT=paper
NO_LIVE_TRADING=true
ENABLE_LIVE_TRADING=false
INCLUDE_LIVE_MODULES=false

# Host-side URL (psql / CLI from the box's shell). Containers get postgres:5432 from compose.
# Credentials come from infra/.env (same keys as Box A, its own password).
DATABASE_URL=postgresql+psycopg://ratp:ratp_password@localhost:5433/ratp

# Market data comes from the S3 datasets Box A publishes, so no Alpaca keys are needed for
# the nightly pull or for replays. Leave these empty unless a job genuinely needs the data
# API; if so, use a key pair from a separate paper account, never Box A's.
PAPER_BROKER_API_KEY=
PAPER_BROKER_API_SECRET=
ALPACA_DATA_FEED=iex

# Where Box A publishes versioned Parquet (and where this box will put run artifacts).
# The box authenticates with its instance role (ratp-worker); no keys here.
DATASET_S3_BUCKET=
DATASET_S3_PREFIX=datasets
DATASET_S3_REGION=us-east-2

# Box A's OTel collector, gRPC, reached over the VPC private IP (Box A's security group must
# allow 4317 from this box's security group). Used by infra/observability/otel-collector-worker.yaml.
BOX_A_OTLP_ENDPOINT=http://10.0.0.0:4317
