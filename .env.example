APP_ENV=dev

# Host-side URL (CLI, tests, alembic run from your shell). Matches docker-compose.yml's
# postgres service (see infra/.env.example for credentials).
# Containers do not use this value: docker-compose.yml points them at postgres:5432.
DATABASE_URL=postgresql+psycopg://ratp:ratp_password@localhost:5433/ratp

# Only needed if infra/.env uses non-default Postgres credentials: docker-compose.yml builds the
# containers' DATABASE_URL from these (defaults: ratp / ratp_password / ratp).
# POSTGRES_USER=ratp
# POSTGRES_PASSWORD=ratp_password
# POSTGRES_DB=ratp

# Required: the API will not start without it.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

TRADING_ENVIRONMENT=paper
NO_LIVE_TRADING=true

# Shadow mode runs the whole trading cycle but never sends an order to the broker: intents
# are generated, risk-checked and persisted, nothing reaches Alpaca. It defaults to TRUE,
# so a paper box only trades once this is explicitly false.
# SHADOW_MODE_ENABLED=true

# Order throttle (account-wide). An intent that trips a limit is rejected and audited
# (ORDER_REJECTED_BY_THROTTLE, tracked order REJECTED); the tick's other intents still go out.
# MAX_ORDERS_PER_BAR=1
# MAX_ORDERS_PER_HOUR=20

# Dollar limits, checked per intent against the ledger's positions plus today's fills
# (ORDER_REJECTED_BY_RISK_LIMIT; the tick's other intents still go out). A buy is refused
# when it would push gross exposure or the symbol's exposure over its cap, or the day's
# traded notional (buys + sells) over MAX_DAILY_NOTIONAL_TRADED. Size them together: with
# $25k orders, $100k of daily notional is four orders.
# MAX_GROSS_EXPOSURE=100000
# MAX_SYMBOL_EXPOSURE=10000
# MAX_DAILY_NOTIONAL_TRADED=25000
# MAX_RESERVED_CASH=25000

# Alpaca paper trading credentials (required for ingestion/broker-integration CLI commands)
PAPER_BROKER_API_KEY=
PAPER_BROKER_API_SECRET=

# Market-data feed for bar requests. The free plan can only use "iex" (default); "sip"
# needs a paid data subscription and fails on recent data otherwise.
# ALPACA_DATA_FEED=iex
# Market-data host for latest trades/quotes (separate from the trading host). Leave unset.
# ALPACA_DATA_BASE_URL=https://data.alpaca.markets

# Share of the universe that may miss a 5-minute bar before an intraday ingestion tick
# fails outright (no features, no trading that tick). Missing bars are always recorded as
# incidents, and above 20% as an SLA breach; this is only the hard stop. IEX prints no
# trade for thin names in some minutes, so keep it well above 0.2. 1 disables the stop.
# INGESTION_MISSING_BAR_FAIL_RATIO=0.5

# A completed 5-minute bar validated more than this many seconds after its window ended
# is flagged LATE and audited, but still stored: the bar is what the market did, only the
# fetch was slow. Whether it is fresh enough to trade on is the trading cycle's 60 s
# readiness grace, so keep this above 60 and a healthy day stays quiet.
# INGESTION_LATE_BAR_SECONDS=120

# Parquet publish to S3 at the end of the end-of-day chain (Box A only). Unset = off.
# The box authenticates with its instance role; no keys here.
# DATASET_S3_BUCKET=
# DATASET_S3_PREFIX=datasets
# DATASET_S3_REGION=
